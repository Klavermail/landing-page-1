{
  "brand": {
    "ink": "#000000",
    "lime": "#C6FF00",
    "limeDim": "#A8D900",
    "limeDeep": "#6F8F00"
  },
  "surface": {
    "surface": "#070806",
    "panel": "#0A0B09",
    "panel2": "#101210",
    "panel3": "#161815"
  },
  "line": {
    "line": "rgba(255,255,255,0.09)",
    "lineStrong": "rgba(255,255,255,0.16)"
  },
  "text": {
    "primary": "#FFFFFF",
    "mute": {
      "value": "rgba(255,255,255,0.56)",
      "contrastOnBlack": "6.49:1",
      "use": "body copy"
    },
    "mute2": {
      "value": "rgba(255,255,255,0.38)",
      "contrastOnBlack": "3.39:1",
      "use": "labels and captions only \u2014 fails AA for body"
    }
  },
  "type": {
    "display": {
      "family": "Inter Tight",
      "weight": 600,
      "tracking": "-0.03em",
      "leading": 0.98,
      "scale": "clamp(2.5rem, 7.2vw, 5.75rem)"
    },
    "h2": {
      "scale": "clamp(2rem, 4.6vw, 3.5rem)"
    },
    "h3": {
      "scale": "clamp(1.375rem, 2.4vw, 1.875rem)"
    },
    "lead": {
      "scale": "clamp(1.0625rem, 1.5vw, 1.3125rem)",
      "leading": 1.55
    },
    "body": {
      "family": "Inter",
      "weight": 400,
      "size": "15-15.5px",
      "leading": 1.7
    },
    "label": {
      "family": "JetBrains Mono",
      "size": "11px",
      "tracking": "0.18em",
      "transform": "uppercase"
    }
  },
  "shape": {
    "radiusCard": "18px",
    "radiusInner": "12-14px",
    "radiusButton": "9999px"
  },
  "motion": {
    "easeEnter": "cubic-bezier(0.16, 1, 0.3, 1)",
    "durEnter": "0.85s",
    "continuous": "linear \u2014 eased curves read as broken on marquees",
    "reducedMotion": "always honoured"
  },
  "rules": {
    "limeCoverage": "accent only \u2014 above ~5% of a screen it stops working",
    "depth": "1px border plus a soft gradient; glow only on lime",
    "imageExport": "email designs >=600px wide, no height cap, lossless WebP"
  }
}
